# 复制本文件为 .env 后修改下列值。.env 含密钥，不入库。

# MySQL 连接串：mysql+pymysql://用户名:密码@主机:端口/库名
# 密码里的 @ : / # 等字符要百分号编码（@ → %40，: → %3A，/ → %2F，# → %23）
DATABASE_URL=mysql+pymysql://root:你的数据库密码@localhost:3306/file_agent

# JWT 签名密钥，必须换成随机长字符串
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=请替换为随机字符串

# token 有效期（小时），默认 2；开发期嫌频繁掉登录可调大
JWT_EXPIRE_HOURS=2

# 上传/输出目录，相对 server/ 的路径，首次启动自动创建
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# 允许跨域访问的前端地址，多个用逗号分隔；不填默认 http://localhost:5173
# 必须在 config.py 的 Settings 里声明成字段才生效，os.getenv 读不到 .env
CORS_ORIGINS=http://localhost:5173

# ---------- LLM 调用 ----------
# 连接阶段超时（秒），只管 TCP + TLS 建连
LLM_TIMEOUT_CONNECT=10
# 读取阶段超时（秒），长文档 / 批改类任务要放宽
LLM_TIMEOUT_READ=120
# 重试次数，0 = 不重试。只重试网络错误 / 超时 / 429 / 5xx，其他 4xx 不重试
LLM_MAX_RETRIES=2
# 进程内同时在飞的 LLM 请求上限；多 worker 部署时每进程各算各的
LLM_MAX_CONCURRENCY=4
# 是否让 httpx 读系统代理。访问需代理的境外端点要 true；
# 若报 InvalidURL: Invalid port，说明 NO_PROXY 里有非法写法，改 false
LLM_TRUST_ENV_PROXY=true

# ---------- 日志 ----------
# root logger 级别，排查重试与并发问题时调成 DEBUG
LOG_LEVEL=INFO