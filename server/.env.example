# 复制本文件为 .env 后修改下列值。.env 含密钥，不入库。

# Postgres 连接串：postgresql+psycopg2://用户名:密码@主机:端口/库名
# 密码里的 @ : / # 等字符要百分号编码（@ → %40，: → %3A，/ → %2F，# → %23）
# 阶段 4 起本地用 Docker 跑 pgvector/pgvector:pg16，宿主机端口 5434
DATABASE_URL=postgresql+psycopg2://fileagent:fileagent_dev@localhost:5434/file_agent

# JWT 签名密钥，必须换成随机长字符串
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=请替换为随机字符串

# token 有效期（小时），默认 2；开发期嫌频繁掉登录可调大
JWT_EXPIRE_HOURS=2

# 上传/输出目录，相对 server/ 的路径，首次启动自动创建
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# 允许跨域访问的前端地址，多个用逗号分隔；不填默认 http://localhost:5173
# 必须在 config.py 的 Settings 里声明成字段才生效，os.getenv 读不到 .env
CORS_ORIGINS=http://localhost:5173

# ---------- LLM 调用 ----------
# 连接阶段超时（秒），只管 TCP + TLS 建连
LLM_TIMEOUT_CONNECT=10
# 读取阶段超时（秒），长文档 / 批改类任务要放宽。
# 实测参考：1117 字的中文 PDF 走批改，思考模型单次要 240s（关掉思考 12s）。
# 端点默认开思考时这里要给到 300 左右，否则会重试到耗尽后失败
LLM_TIMEOUT_READ=180
# 重试次数，0 = 不重试。只重试网络错误 / 超时 / 429 / 5xx，其他 4xx 不重试
LLM_MAX_RETRIES=2
# 进程内同时在飞的 LLM 请求上限；多 worker 部署时每进程各算各的
LLM_MAX_CONCURRENCY=4
# 是否发送 enable_thinking（DashScope 兼容端的思考开关）。
# 留空/不写 = 请求体不带这个字段，各家端点保持原有行为；
# false 可把思考模型从 240s 压到 12s，代价是可能降低批改质量，需自己权衡
# LLM_ENABLE_THINKING=false
# 是否让 httpx 读系统代理。访问需代理的境外端点要 true；
# 若报 InvalidURL: Invalid port，说明 NO_PROXY 里有非法写法，改 false
LLM_TRUST_ENV_PROXY=true

# ---------- 长文档分块批改（阶段 3）----------
# 每块字符预算，中文约 1 字 ≈ 1 token。整篇不超过这个值就不分块，走单发路径
LONGDOC_CHUNK_CHARS=6000
# 总开关。调成 false 可把长文档也压回单发路径，用来跟分块结果做对比
LONGDOC_ENABLED=true
# ⚠ 阶段 4 起分块批改的检查点与按块缓存都在 Postgres（与业务表同库），
# 老的 CHECKPOINT_PATH 配置项已撤，留在这行的注释里只为说明历史

# ---------- 规范文档入库（阶段 4）----------
# 单条条款的字符上限（不是装箱目标）。超过它的超长条款才退回按句细分
SPEC_CHUNK_CHARS=2000

# ---------- 规范库向量检索（阶段 6）----------
# ⚠ 这两项**必须填**，没有默认值：本机 LM Studio 的端口随上次启动漂移，
# 写死一个默认值只会让编码请求打到别的模型上。留空 = 任何编码调用直接报错。
# 查当前端口：LM Studio 开发者页，或 netstat 找它监听的端口
EMBEDDING_BASE_URL=http://127.0.0.1:11386/v1
# 模型名要写死：同一服务上常挂着不同维度的模型（bge-m3=1024、nomic-v1.5=768）
EMBEDDING_MODEL=text-embedding-bge-m3
# 向量维度，必须与上面那个模型的实际输出一致，也和 spec_chunks.embedding 列宽一致
EMBEDDING_DIMENSIONS=1024
# 本地服务留空；云端端点在这里填密钥
EMBEDDING_API_KEY=
# 单次编码请求超时秒数（批量发，不需要 LLM 那套 180s）
EMBEDDING_TIMEOUT=60
# 查询前缀取决于模型的训练方式：bge-large-zh 那批要加"为这个句子生成表示以用于检索相关文章："，
# bge-m3 **不加**（它训练时不带指令）。本机实测 bge-m3 加了反而 recall@5 从 0.491 掉到 0.380，
# 所以默认留空。换 embedding 模型时按该模型的官方说明改这一行。
EMBEDDING_QUERY_PREFIX=
# 入库时同步算向量。false = 只存文本，向量交给 backfill 脚本
SPEC_EMBED_ON_INGEST=true
# 批改前是否自动召回规范条款。false 时批改链路与阶段 6 之前逐字一致，评测台靠它做 RAG A/B
SPEC_RAG_ENABLED=true
# 检索返回几条条款（规范条款平均 165 字）
SPEC_RETRIEVAL_TOP_K=5
# 召回方式：hybrid（默认，向量+词法 RRF 融合）/ vector / lexical。评测台用它做消融
SPEC_RETRIEVAL_MODE=hybrid
# 注入批改 prompt 的条款上下文字数上限，超了从末尾截断
SPEC_CONTEXT_MAX_CHARS=3000
# 查询滑窗：bge 对超长输入静默截断，整篇一次编码等于只拿开头去检索
SPEC_QUERY_WINDOW_CHARS=800
# 最多几个窗口；文档太长超窗口数时等步长抽样（覆盖首尾比只取开头诚实）
SPEC_QUERY_MAX_WINDOWS=4

# ---------- PPT 渲染（阶段 5 s5.4）----------
# stub = 1×1 占位 PNG（默认，无需任何外部依赖）；soffice = 经 WSL LibreOffice 真渲染
# 启用 soffice 需要：Windows + WSL2 + Ubuntu 里 apt install libreoffice-impress
PPT_RENDER_BACKEND=stub
# 真渲染出图 DPI（72 糊、200 大，100 是 VLM 看图与审计之间折中）
PPT_RENDER_DPI=100
# soffice 单次转换超时秒数，首次冷启动慢
PPT_RENDER_TIMEOUT=90

# ---------- PPT 版面检查循环（② 片3）----------
# false = 即使配了视觉模型也不跑版面批评循环（只保留坏块修复）
PPT_LAYOUT_ENABLED=true
# 批评 VLM 调用次数上限（pass 会提前停；代码硬上限 5）
PPT_LAYOUT_MAX_ROUNDS=2

# ---------- MinerU 扫描件兜底 ----------
# 官方云 API token：https://mineru.net/apiManage 申请（有效期 90 天，到期要续）。
# 留空 = 功能关闭，扫描件照旧拒收，行为与接入前完全一致。token 不入库
MINERU_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4
# 轮询间隔（秒）与最长等待（秒）：云 API 异步任务，排队 + 解析可达分钟级
MINERU_POLL_INTERVAL=3
MINERU_MAX_WAIT=600
# 单次 HTTP 请求超时（秒），上传/下载 zip 用，与轮询总时长是两回事
MINERU_HTTP_TIMEOUT=60

# ---------- 日志 ----------
# root logger 级别，排查重试与并发问题时调成 DEBUG
LOG_LEVEL=INFO