# docker-compose 用的变量文件（**不是** server/.env，那份是本地开发读的）
# 用法：cp .env.example .env，填完再 docker compose up -d
# ⚠ .env 已 gitignore；这份模板里全是占位值，不要直接拿去上线

# ---------- 必填 ----------
# 数据库密码。改了这里要记得同步备份/恢复脚本里的连接串
DB_PASSWORD=change-me
# JWT 签名密钥。生成：openssl rand -base64 48
# 换了它 = 所有人掉线（现有 token 全部失效），不会损坏数据
JWT_SECRET_KEY=
# 模型密钥的 Fernet 加密密钥。丢了 = 库里所有 api_key 不可恢复（AGENTS §3.24）
# 生成：docker compose run --rm backend uv run python -c "from services.secrets import generate_key; print(generate_key())"
API_KEY_ENC_KEY=

# 站点地址。有域名就填域名（Caddy 自动签真证书）；
# 没域名填 IP 时要把 deploy/Caddyfile.server 的证书段改成 tls internal
SITE_ADDRESS=localhost
# 有域名时用于 ACME 通知邮箱
ACME_EMAIL=

# ---------- 可选（不填就用 docker-compose.yml 里的默认值）----------
DB_USER=fileagent
DB_NAME=file_agent
LOG_LEVEL=INFO

# 扫描件 OCR / PDF 版面识别：留空 = 功能关闭，上传时明确拒收而不是半途失败
MINERU_TOKEN=
# 规范库向量检索：留空 = 注册时的参考文档跳过入库（不挡注册）
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024

# 成本闸。0 = 不限制，对外开放前一定要设（AGENTS §3.21 / §3.22）
MAX_PROCESSES_PER_DAY=20
MAX_REGISTRATIONS_PER_DAY=20
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=300
RETENTION_DAYS=30
# 改完密码后旧 token 的存活窗口，公网部署别设太长
JWT_EXPIRE_HOURS=2

# 前端由 Caddy 同源伺服，走不到 CORS；只有前后端分源才需要改
CORS_ORIGINS=http://localhost:5241
