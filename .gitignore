# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
.env.local

# 环境变量（含密码，绝对不能提交）
.env
.env.*
# 例外：配置模板要入库（只有占位值，无真实密钥）
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# 前端
node_modules/
dist/
.vite/
# unplugin-vue-components 每次构建重新生成，入库只会让 diff 变吵
client/src/components.d.ts

# 上传/输出文件（运行时生成，不跟踪）
server/uploads/
server/outputs/

# 运行日志（后端 RotatingFileHandler 与 Caddy access log），本机排障用，不入库
server/logs/
deploy/logs/

# 评测台每轮的 run JSON（本机跑出来的数字，入库会让对比基线到处漂；数字抄进 SPEC §9.6）
server/eval/runs/

# LangGraph 检查点（阶段 3）：本机续跑状态，会持续变大，不入库
server/checkpoints/

# uv lock 文件可以提交（类似 pom.xml.lock，保证依赖一致）
# uv.lock 不加 .gitignore

# 测试与覆盖率
.pytest_cache/
.coverage
coverage.xml

# Linter / Formatter 缓存
.ruff_cache/

# 日志文件
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Qoder
.qoder-credits/

# 数据库导出/迁移前备份：可能含明文密钥，永不入库
_backup*.sql
server/_backup*.sql

# SPEC.md 是本地设计文档（缺陷台账、DDL、各阶段交付细节），不对外发布；
# 仓库里只保留 README.md 与 AGENTS.md。文件本身仍在磁盘上，AGENTS 里对它的引用按本机看
SPEC.md
